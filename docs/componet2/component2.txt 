## 15) Minimal pseudocode (per claim inference)

```python
def component2_infer(claim, A, S, C, diagnostics):
    # 1) build graph from A∪C
    G = build_graph(A + C, anchors=claim.entities)

    # 2) compute bridge bonus on G
    bridge_bonus = compute_bridge_bonus(G, anchors=G.anchors)

    # 3) run reasoner with combined mask
    logits, salience = reasoner_forward(G, bridge_bonus=bridge_bonus)

    # 4) optional recovery
    if diagnostics.ESI < tau_esi and diagnostics.RPIk > tau_rpi:
        recovered = select_recovery_edges(S, bridge_bonus, claim)
        G2 = build_graph(A + recovered + C, anchors=claim.entities)
        bridge_bonus2 = compute_bridge_bonus(G2, anchors=G2.anchors)
        logits2, salience2 = reasoner_forward(G2, bridge_bonus=bridge_bonus2)
        logits, salience = logits2, salience2

    # 5) abstention head
    abstain_score = abstain_head(logits, diagnostics, G.stats)
    label, conf = softmax(logits).argmax(), softmax(logits).max()
    abstained = abstain_score > tau_abstain

    # 6) rationale edges
    rationale = top_edges_by_salience(salience)

    return label, conf, abstain_score, abstained, rationale
```

